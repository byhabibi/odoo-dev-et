<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsn_approval_purchase_order_form_view" model="ir.ui.view">
        <field name="name">dsn.approval.purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="user_in_assigned_to" invisible="1"/>
                <field name="is_approved" invisible="1"/>
                <field name="assigned_to_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,to approve,purchase</attribute>
            </xpath>
            <xpath expr="//button[@name='button_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='button_approve']" position="after">
                <button name="dsn_button_approve" type="object" string="Approve Order" context="{'validate_analytic': True}" class="oe_highlight" 
                attrs="{'invisible': ['|','&amp;', ('is_approved', '=', True), ('state', 'in', ['to approve']), ('user_in_assigned_to', '=', False)]}"/>
            </xpath>
            
            <xpath expr="//header/button[@name='print_quotation']" position="after">
                <button name="request_approval" type="object" string="Request Approval" context="{'validate_analytic': True}" class="oe_highlight" attrs="{'invisible': ['|', ('is_approved', '=', True), ('state', 'not in', ['draft','sent'])]}"/>
                <!-- <button name="button_confirm_to_approve" type="object" string="Confirm Order" context="{'validate_analytic': True}" attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}"/> -->
            </xpath>
            
            <xpath expr="//notebook/page[@name='purchase_delivery_invoice']" position="after">
                <page name="approver" string="Approver">
                    <group>
                        <group>
                            <field name="approval_purchase_id"/>
                            <field name="approval_rule"/>
                            <field name="approval_type"/>
                        </group>
                    </group>
                    <field name="approval_line_ids" mode="tree" readonly="1">
                        <tree string="Approval Line" name="approval_line" editable="bottom">
                            <field name="user_id"/>
                            <field name="is_approved"/>
                            <field name="date_approved"/>
                        </tree>
                    </field>
                </page>
            </xpath>   
        </field>
    </record>
    <!-- purchase order to approve search view -->
    <record id="dsn_to_approve_purchase_order_view_search" model="ir.ui.view">
        <field name="name">dsn.to.approve.po.search</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <filter name="assigned_to_ids" string="Assigned to me" domain="[('assigned_to_ids','in',[uid])]"/>
            </xpath>
        </field>
    </record>
</odoo>