<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_approval">
        <field name="name">Approval</field>
        <field name="description">Helps you manage your approval.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="dsn_approval.module_category_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">The user will not be able to approve document created by employees.</field>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">The user will be able to manage and approve document created by employees.</field>
        <field name="category_id" ref="dsn_approval.module_category_approval"/>
        <field name="implied_ids" eval="[(4, ref('dsn_approval.group_approval_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>