<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsn_hr_employee_form_view" model="ir.ui.view">
        <field name="name">dsn.hr.employee.form.inheirt</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="hr_approver" string="Approver">
                    <field name="approver_ids" mode="tree">
                        <tree string="Input Data" editable="bottom">
                            <field name="job_id"/>
                            <field name="user_id" domain="[('id', 'in', user_ids)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="user_ids" widget="many2many_tags" invisible="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>