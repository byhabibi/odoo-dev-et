<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mes_scan_approval_tree" model="ir.ui.view">
        <field name="name">mes.scan.approval.tree</field>
        <field name="model">mes.scan.approval</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="employee_id"/>
                <field name="barcode"/>
                <field name="check_in"/>
                <field name="scan_time"/>
                <field name="shift_id"/>
                <field name="workorder_info" nolabel="1" readonly="1"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_mes_scan_approval_form" model="ir.ui.view">
        <field name="name">mes.scan.approval.form</field>
        <field name="model">mes.scan.approval</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" states="draft"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" states="draft"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,running,done"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="barcode"/>
                        <field name="check_in"/>
                        <field name="scan_time"/>
                        <field name="shift_id"/>
                    </group>
                    <field name="workorder_info" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mes_scan_approval_kanban" model="ir.ui.view">
        <field name="name">mes.scan.approval.kanban</field>
        <field name="model">mes.scan.approval</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false">
                <field name="employee_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="employee_id"/></strong><br/>
                            Shift: <field name="shift_id"/><br/>
                            Status: <field name="state"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mrp_production_workorder_tree_inherit" model="ir.ui.view">
        <field name="name">mrp.production.workorder.tree.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
        <field name="arch" type="xml">
             <field name="production_id" position="after">
                <field name="employee_id" optional="show"/>
                <field name="shift_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_mes_scan_approval" model="ir.actions.act_window">
        <field name="name">MES Scan Approval</field>
        <field name="res_model">mes.scan.approval</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem id="menu_mes_scan_root" name="MES Scan"/>
    <menuitem id="menu_mes_scan_approval" parent="menu_mes_scan_root" action="action_mes_scan_approval" name="Approval"/>

</odoo>
