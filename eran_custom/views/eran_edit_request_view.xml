<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mes_edit_request_tree" model="ir.ui.view">
        <field name="name">mes.scan.approval.edit.request.tree</field>
        <field name="model">mes.scan.approval.edit.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" string="Tanggal Request"/>
                <field name="requested_by"/>
                <field name="workorder_id"/>
                <field name="current_qty"/>
                <field name="state" decoration-warning="state=='waiting'" decoration-success="state=='approved'" decoration-danger="state=='rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_mes_edit_request_form" model="ir.ui.view">
        <field name="name">mes.scan.approval.edit.request.form</field>
        <field name="model">mes.scan.approval.edit.request</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button name="action_approve"
                        string="Setujui &amp; Terapkan"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'waiting')]}"/>

                    <button name="action_reject"
                        string="Tolak"
                        type="object"
                        class="btn-danger"
                        attrs="{'invisible': [('state', '!=', 'waiting')]}"/>

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="waiting,approved"/>

                </header>

                <sheet>
                    <group>
                        <field name="requested_by"/>
                        <field name="workorder_id"/>
                        <field name="current_qty"/>
                        <field name="new_qty" placeholder="Masukkan jumlah output aktual yang benar"/>
                        <field name="note"/>
                    </group>

                    <group attrs="{'invisible': [('state', '=', 'waiting')]}">
                        <field name="approved_by"/>
                        <field name="approved_date"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mes_edit_request" model="ir.actions.act_window">
        <field name="name">MES Edit Request</field>
        <field name="res_model">mes.scan.approval.edit.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_waiting': 1}</field>
    </record>

    <menuitem
        id="menu_mes_kiosk"
        parent="dsn_approval_mrp.menu_item_dsn_approval_setting_mrp"
        action="action_mes_kiosk_mode"
        name="MO Scan"
        sequence="20"/>

</odoo>