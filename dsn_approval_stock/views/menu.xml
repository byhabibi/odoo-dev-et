<?xml version="1.0" encoding="UTF-8"?>
<odoo>    
    <!-- Action Window Approval Settings -->
    <record id="action_dsn_approval_stock" model="ir.actions.act_window">
      <field name="name">Stock Approval</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">dsn.approval.stock</field>
      <field name="view_mode">tree,form</field>
    </record>
    <!-- Approval Settings Menuitem -->
    <menuitem id="menu_item_dsn_approval_setting_stock"
              name="Stock"
              sequence="4"
              parent="dsn_approval.menu_item_dsn_approval_setting"
              groups="dsn_approval.group_approval_manager"
              action="action_dsn_approval_stock"/>
    <!-- To Approve Menuitem -->
    <menuitem id="menu_item_dsn_to_approve_stock"
                name="Stock"
                sequence="4"
                parent="dsn_approval.menu_item_dsn_to_approve"/>
</odoo>