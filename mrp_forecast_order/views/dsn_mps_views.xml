<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsn_view_mps_tree" model="ir.ui.view">
        <field name="name">dsn.view.mps.tree</field>
        <field name="model">dsn.mps</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <header>
                    <button name="generate_multi_mo" string="Generate Manufacturing Order" type="object"/>
                </header>
                <field name="name" readonly="1"></field>
                <field name="demand_id" invisible="1"></field>
                <field name="product_id" options="{'no_create': True}" readonly="1" domain="[('sale_ok', '=', True)]"/>
                <field name="uom_id" readonly="1"></field>
                <field name="bom_id" readonly="1"></field>
                <field name="production_qty" attrs="{'readonly': [('mo_ids', '!=', [])]}"></field>
                <field name="balance" readonly="1"></field>
                <field name="scheduled_date" attrs="{'readonly': [('mo_ids', '!=', [])]}"></field>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="show" readonly="1"/>
                <field name="mo_ids" widget="many2many_tags" readonly="1"></field>
                <button icon="fa-info-circle" name="view_mo" type="object"/>
                <field name="state" readonly="1" decoration-success="state in ('done', 'to_close')" decoration-warning="state == 'progress'" decoration-info="state == 'confirmed'" decoration-danger="state == 'cancel'" decoration-muted="state == 'draft'" widget="badge" class="text-dark"/>
            </tree>
        </field>
    </record>

    <record id="dsn_view_mps_filter" model="ir.ui.view">
        <field name="name">dsn.view.mps.filter</field>
        <field name="model">dsn.mps</field>
        <field name="arch" type="xml">
            <search string="Search MPS">
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="demand_id" string="Demand Order" filter_domain="[('demand_id', 'ilike', self)]"/>
                <field name="product_id" string="Product" filter_domain="[('product_id', 'ilike', self)]"/>
                <group expand="0" string="Group By...">
                    <filter string="Demand Order" name="demand_order" domain="[]" context="{'group_by': 'demand_id'}"/>
                    <filter string="Product" name="product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Scheduled Date" name="scheduled_date" domain="[]" context="{'group_by': 'scheduled_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_mps_pivot" model="ir.ui.view">
        <field name="name">view.mps.pivot</field>
        <field name="model">dsn.mps</field>
        <field name="arch" type="xml">
            <pivot string="MPS" sample="1">
                <field name="scheduled_date" type="row"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_mps_graph" model="ir.ui.view">
        <field name="name">view.mps.graph</field>
        <field name="model">dsn.mps</field>
        <field name="arch" type="xml">
            <graph string="MPS" sample="1">
                <field name="scheduled_date"/>
                <field name="balance" type="measure"/>
            </graph>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="dsn_action_mps">
        <field name="name">MPS</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dsn.mps</field>
        <field name="domain">[]</field>
        <field name="context">{'create': 0, 'copy': 0, 'delete':0, 'search_default_demand_order': 1, 'search_default_product': 1}</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('dsn_view_mps_tree')}),
                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_mps_pivot')}),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('view_mps_graph')})]"/>
        <field name="search_view_id" ref="dsn_view_mps_filter"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new demand order for demand order detail process and generate mps from demand order detail.
            </p>
            <p>
                MPS of semi-finished and finished goods.
            </p>
        </field>
    </record>

    <record id="dsn_mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">dsn.mrp.production.form.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="dsn_mps_id" force_save="1" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>