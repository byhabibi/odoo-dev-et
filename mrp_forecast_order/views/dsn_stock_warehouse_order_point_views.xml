<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsn_view_warehouse_orderpoint_form" model="ir.ui.view">
        <field name="name">dsn.stock.warehouse.orderpoint.form</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="product_category_id" invisible="1"/>
                            <field name="product_tmpl_id" invisible="1"/>
                            <field name="trigger" invisible="1"/>
                            <field name="product_id" attrs="{'readonly': [('product_id', '!=', False)]}" force_save="1"/>
                            <field name="location_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations"/>
                            <field name="warehouse_id" options="{'no_create': True}" groups="stock.group_stock_multi_warehouses"/>
                            <field name="qty_on_hand" force_save="1"/>
                            <field name="qty_forecast" force_save="1"/>
                            <field name="route_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_min_qty"/>
                            <field name="product_max_qty"/>
                            <field name="qty_to_order"/>
                            <field name="product_uom_name" string="UoM" groups="uom.group_uom"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <!-- <button name="action_product_forecast_report" type="object" icon="fa-area-chart" title="Forecast Report" attrs="{'invisible': [('id', '=', False)]}"/>
                            <button name="action_stock_replenishment_info" type="object" icon="fa-info-circle" title="Replenishment Information" attrs="{'invisible': [('id', '=', False)]}"/>
                            <button name="action_replenish" string="Order Once" type="object" class="o_replenish_buttons" icon="fa-truck" attrs="{'invisible': [('qty_to_order', '&lt;=', 0.0)]}"/>
                            <button name="action_replenish_auto" string="Automate Orders" type="object" class="o_replenish_buttons" icon="fa-refresh" attrs="{'invisible': ['|', ('qty_to_order', '&lt;=', 0.0), ('trigger', '=', 'auto')]}"/>
                            <button name="380" string="Snooze" type="action" class="text-warning" icon="fa-bell-slash" attrs="{'invisible': [('trigger', '!=', 'manual')]}" context="{'default_orderpoint_ids': [id]}"/> -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>