<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dsn_view_mrp_tree" model="ir.ui.view">
        <field name="name">dsn.view.mrp.tree</field>
        <field name="model">dsn.mrp</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <header>
                    <button name="merge_create_pr" type="object" string="Create Purchase Request"/>
                </header>
                <field name="name" readonly="1"></field>
                <field name="demand_id" invisible="1"></field>
                <field name="product_id" options="{'no_create': True}" readonly="1" domain="[('sale_ok', '=', True)]"/>
                <field name="uom_id" readonly="1"></field>
                <field name="bom_id" readonly="1"></field>
                <field name="mrp_buffer_stock"></field>
                <button icon="fa-info-circle" name="view_buffer_stock" type="object"/>
                <field name="demand_qty" readonly="1"></field>
                <field name="stock_on_hand" readonly="1"></field>
                <field name="quantity_to_buy" readonly="1"></field>
                <field name="quantity_pr" readonly="1"></field>
                <button icon="fa-info-circle" name="view_pr" type="object"/>
                <field name="quantity_po" readonly="1"></field>
                <button icon="fa-info-circle" name="view_po" type="object"/>
                <field name="received_qty" readonly="1"></field>
                <field name="balance" readonly="1"></field>
                <field name="deadline_date"></field>
                <button name="create_buffer_stock" string="Generate Buffer Stock" type="object"/>
                <field name="purchase_request_line_id" optional="show"  readonly="1"></field>
                <!-- <button name="create_pr" string="Generate Purchase Request" type="object"/> -->
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="show"  readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="dsn_view_mrp_filter" model="ir.ui.view">
        <field name="name">dsn.view.mrp.filter</field>
        <field name="model">dsn.mrp</field>
        <field name="arch" type="xml">
            <search string="Search MRP">
                <field name="name" string="Name" filter_domain="[('name', 'ilike', self)]"/>
                <field name="demand_id" string="Demand Order" filter_domain="[('demand_id', 'ilike', self)]"/>
                <field name="product_id" string="Product" filter_domain="[('product_id', 'ilike', self)]"/>
                <group expand="0" string="Group By...">
                    <filter string="Demand Order" name="demand_order" domain="[]" context="{'group_by': 'demand_id'}"/>
                    <filter string="Product" name="product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Deadline Date" name="deadline" domain="[]" context="{'group_by': 'deadline_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_mrp_pivot" model="ir.ui.view">
        <field name="name">view.mrp.pivot</field>
        <field name="model">dsn.mrp</field>
        <field name="arch" type="xml">
            <pivot string="MRP" sample="1">
                <field name="deadline_date" type="row"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_mrp_graph" model="ir.ui.view">
        <field name="name">view.mrp.graph</field>
        <field name="model">dsn.mrp</field>
        <field name="arch" type="xml">
            <graph string="MRP" sample="1">
                <field name="deadline_date"/>
                <field name="balance" type="measure"/>
            </graph>
        </field>
    </record>
    
    <record model="ir.actions.act_window" id="dsn_action_mrp">
        <field name="name">MRP</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dsn.mrp</field>
        <field name="domain">[]</field>
        <field name="context">{'create': 0, 'copy': 0, 'delete':0, 'search_default_demand_order': 1}</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('dsn_view_mrp_tree')}),
                (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_mrp_pivot')}),
                (0, 0, {'view_mode': 'graph', 'view_id': ref('view_mrp_graph')})]"/>
        <field name="search_view_id" ref="dsn_view_mrp_filter"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new demand order for demand order detail process and generate mrp from demand order.
            </p>
            <p>
                MRP of material.
            </p>
        </field>
    </record>

    <record id="dsn_inherit_view_purchase_request_form" model="ir.ui.view">
        <field name="name">dsn.inherit.view.purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/tree/field[@name='purchase_state']" position="after">
                <field name="mrp_id" force_save="1" optional="hide" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='assigned_to']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="dsn_inherit_view_purchase_order_line_tree" model="ir.ui.view">
        <field name="name">dsn.inherit.view.purchase.order.line.tree</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="qty_received" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>