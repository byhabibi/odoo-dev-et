<?xml version="1.0" encoding="utf-8"?>
<odoo>    



    <record id="dsn_approval_mrp_tree_view" model="ir.ui.view">
        <field name="name">dsn.approval.mrp.tree.view</field>
        <field name="model">dsn.approval.mrp</field>
        <field name="arch" type="xml">
            <tree string="Approval Mrp">
                <field name="reference"/>
                <field name="models"/>
                <field name="approval_type"/>
                <field name="approval_rule"/>
            </tree>
        </field>
    </record>
    <record id="dsn_approval_mrp_form_view" model="ir.ui.view">
        <field name="name">dsn.approval.mrp.form.view</field>
        <field name="model">dsn.approval.mrp</field>
        <field name="arch" type="xml">
            <form string="Approval Mrp">
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="models"/>
                            <field name="approval_type"/>
                            <field name="approval_rule"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Position Details">
                            <field name="job_ids" string="Job Position" mode="tree" attrs="{'readonly': [('approval_type', '=', 'individual-base-approval')]}">
                                <tree string="Job Position" name="job_position_details" editable="bottom">
                                    <field name="sequence" widget="handle"/>    
                                    <field name="job_id"/>
                                    <field name="approval_mrp_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Individual Details">
                            <field name="user_ids" class="oe_inline" string="Approver" mode="tree" attrs="{'readonly': [('approval_type', '=', 'position-base-approval')]}">
                                <tree string="User" name="user_details" editable="bottom">
                                    <field name="sequence" widget="handle"/>    
                                    <field name="user_id"/>
                                    <field name="approval_mrp_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="action_dsn_approval_mrp" model="ir.actions.act_window">
        <field name="name">Mrp</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dsn.approval.mrp</field>
        <field name="view_mode">tree,form</field>
    </record>



</odoo>